.DS_Store
Thumbs.db

# 用户配置（MXU / MaaPiCli 首次启动会自动生成；整个目录不入仓，
# 否则会冲掉每个用户的真实实例 —— maa_option.json / maa_pi_config.json 曾漏网）
config/

# 大模型文件（如果用 Git LFS 或单独下载）
resource/model/ocr/

# 运行时文件
*.log
*.pdb
*.tmp

# Python 字节码缓存
__pycache__/
*.pyc

# 更新器运行时产物
updater_cache.json
updates/

# Agent 工作区记忆（不属于软件本身）
.workbuddy/

# 防御性忽略：这个 0 字节文件由旧版 launcher.bat 注释里的 ">" 重定向产生（不是 MXU 的编码 bug）。
# v26.09.7 起 launcher.bat 已改为纯 ASCII 且不含 ">"，源头已消除；规则保留，以防老目录里的残留被误提交。
鑚姩

# local, machine-specific files
*.lnk

# 本机开发 / 调试辅助脚本（不入仓库，也不入发布包；与 tools/build_release_zip.py 的 EXCLUDE_FILES 对应）
agent/start.bat
agent/start.py
tools/make_icon.py
tools/apply_icon.ps1
# 打包器的双击入口：写死「本机解释器候选路径」，只对作者这台机器有意义。
# 工具本体 tools/build_release_zip.py 是入仓库的，任何维护者 clone 后都能直接 python 跑它。
打包发布包.bat
