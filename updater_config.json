{
    "repo": "alkaidjin/Maa-Assistant-Browndust2",
    "check_interval_hours": 6,
    "asset_keywords_include": ["MABd2"],
    "asset_keywords_exclude": ["source code", "src", "debug", "linux", "macos", "darwin"],
    "download_dir": "updates",
    "log_retention_days": 7,
    "log_compact": true,
    "log_compact_keep_recognition": false,
    "_doc_mirror_url_prefixes": "国内访问 GitHub Releases 普遍被严重限速（实测最低 10 KB/s）。updater 会按顺序尝试列表里的镜像前缀，最后回退到官方原 URL。留空数组 [] 关闭镜像只用官方源。修改后下次启动检测更新时生效。",
    "mirror_url_prefixes": [
        "https://ghps.cc",
        "https://ghfast.top",
        "https://gh-proxy.com",
        "https://mirror.ghproxy.com"
    ]
}
